# Terraform Backend Configuration Example
#
# tutorial.md and README.md both point you here. Declares the "gcs" backend
# so Terraform knows where to look for state, without hardcoding a bucket.
#
# To use this file:
# 1. Copy it to backend.tf:  cp backend.tf.example backend.tf
# 2. Run init, passing your bucket and prefix as flags:
#      terraform init \
#        -backend-config="bucket=my-project-mariadb-byoc-tfstate" \
#        -backend-config="prefix=mariadb-byoc/my-project"
#
# Alternatively, uncomment bucket/prefix below and fill them in directly,
# then run a plain `terraform init`.

terraform {
  backend "gcs" {
    # Bucket holding the state object. Must already exist.
    # bucket = "my-project-mariadb-byoc-tfstate"

    # Object prefix within the bucket. Include the project ID if one bucket
    # holds state for more than one project.
    # prefix = "mariadb-byoc/my-project"
  }
}
