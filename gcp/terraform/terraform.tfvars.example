# Terraform Variables Example
#
# tutorial.md and README.md both point you here. Use this file to fill in
# the values by hand.
#
# To use this file:
# 1. Copy it to terraform.tfvars:  cp terraform.tfvars.example terraform.tfvars
# 2. Replace the placeholder values with the ones shown in the MariaDB Cloud portal
# 3. Run: terraform plan

# REQUIRED: the GCP project to enable MariaDB BYOC in.
project_id = "my-project"

# REQUIRED: your MariaDB Cloud organization ID, shown in the MariaDB Cloud portal.
org_id = "org*****"

# REQUIRED: the GCP project hosting MariaDB Cloud's standard service accounts,
# shown in the MariaDB Cloud portal. The three service account emails are
# derived from it. (See variables.tf if you need to override an individual
# service account email instead.)
orchestration_project_id = "sample-skysql-infra-project"

# REQUIRED: regions MariaDB may create resources in. The first entry is also
# the Google provider's default region. There is no default -- pick at least one.
allowed_regions = ["us-central1"]

# Examples for multiple regions:
# allowed_regions = ["us-central1", "us-east1"]
# allowed_regions = ["europe-west1", "europe-west4"]

# OPTIONAL: where the Terraform state for this deployment lives. Leave empty
# for local state. If you configure a backend by hand (see backend.tf.example),
# set these to match backend.tf exactly -- Terraform cannot check this for you.
# state_bucket = "my-project-mariadb-byoc-tfstate"
# state_prefix = "mariadb-byoc/my-project"
